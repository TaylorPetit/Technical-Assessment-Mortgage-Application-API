@page "/"
@rendermode InteractiveServer
@inject MortgageApplicationApiClient Api
@inject IJSRuntime JS

<PageTitle>Mortgage application</PageTitle>

<main class="page-shell">
    <section class="intro">
        <h1>Mortgage application</h1>
        <p class="lead">Apply or check an existing application.</p>
    </section>

    @if (_validationErrors.Count > 0)
    {
        <section class="validation-popup" role="alert" aria-live="assertive" aria-labelledby="validation-heading">
            <button class="validation-dismiss" type="button" aria-label="Dismiss validation errors" @onclick="DismissValidationErrors">×</button>
            <h2 id="validation-heading">Check your details</h2>
            <ul>
                @foreach (string error in _validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_isError ? "notice-error" : "notice-success")" role="status">@_message</div>
    }

    <div class="content-grid">
        <section class="card application-card" aria-labelledby="application-heading">
            <div class="section-heading">
                <div><h2 id="application-heading">Your details</h2></div>
            </div>

            <EditForm Model="_request" FormName="CreateMortgageApplication"
                      OnValidSubmit="CreateApplicationAsync" OnInvalidSubmit="ShowValidationErrors">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <label>Gross annual income
                        <span class="input-wrap"><span>£</span><InputNumber @bind-Value="_request.AnnualIncome" step="any" /></span>
                    </label>
                    <label>Existing monthly expenses
                        <span class="input-wrap"><span>£</span><InputNumber @bind-Value="_request.MonthlyExpenses" step="any" /></span>
                    </label>
                    <label>Deposit
                        <span class="input-wrap"><span>£</span><InputNumber @bind-Value="_request.DepositAmount" step="any" /></span>
                    </label>
                    <label>Property value
                        <span class="input-wrap"><span>£</span><InputNumber @bind-Value="_request.PropertyValue" step="any" /></span>
                    </label>
                    <label class="term-field">Mortgage term
                        <span class="input-wrap"><InputNumber @bind-Value="_request.TermYears" min="1" step="1" /><span>years</span></span>
                    </label>
                </div>
                <button class="button button-primary" type="submit" disabled="@_isBusy">
                    @(_isBusy ? "Submitting…" : "Submit application") <span aria-hidden="true">→</span>
                </button>
            </EditForm>
        </section>

        <section class="card lookup-card" aria-labelledby="lookup-heading">
            <div class="section-heading">
                <div><h2 id="lookup-heading">Existing application</h2></div>
            </div>
            <label class="lookup-label" for="application-id">Application ID</label>
            <InputText id="application-id" class="text-input" @bind-Value="_applicationId" placeholder="Paste your application ID" />
            <div class="button-row">
                <button class="button button-secondary" @onclick="RetrieveApplicationAsync" disabled="@_isBusy">View application</button>
                <button class="button button-secondary" @onclick="AssessApplicationAsync" disabled="@_isBusy">Check affordability</button>
            </div>

            @if (_application is not null)
            {
                <div class="result-block">
                    <div class="result-title"><div><p class="eyebrow">Application received</p><h3>Application details</h3></div>
                        <button class="copy-id" title="Copy the application ID" @onclick="CopyApplicationIdAsync">Copy ID</button>
                    </div>
                    <p class="id-value">@_application.Id</p>
                    <dl class="details-list">
                        <div><dt>Annual income</dt><dd>@Money(_application.AnnualIncome)</dd></div>
                        <div><dt>Monthly expenses</dt><dd>@Money(_application.MonthlyExpenses)</dd></div>
                        <div><dt>Deposit</dt><dd>@Money(_application.DepositAmount)</dd></div>
                        <div><dt>Property value</dt><dd>@Money(_application.PropertyValue)</dd></div>
                        <div><dt>Term</dt><dd>@_application.TermYears years</dd></div>
                    </dl>
                </div>
            }

            @if (_assessment is not null)
            {
                <div class="assessment @(_assessment.Approved ? "assessment-approved" : "assessment-review")">
                    <p class="eyebrow">Illustrative estimate</p>
                    <h3>@(_assessment.Approved ? "Within the example limits" : "Outside the example limits")</h3>
                    <p>@_assessment.Explanation</p>
                    <dl class="details-list">
                        <div><dt>Loan-to-value</dt><dd>@Percent(_assessment.LoanToValueRatio)</dd></div>
                        <div><dt>Debt-to-income</dt><dd>@Percent(_assessment.DebtToIncomeRatio)</dd></div>
                        <div><dt>Maximum borrowing estimate</dt><dd>@Money(_assessment.MaximumBorrowingEstimate)</dd></div>
                    </dl>
                </div>
            }
        </section>
    </div>
</main>

@code {
    private readonly CreateMortgageApplicationRequest _request = new();
    private string _applicationId = string.Empty;
    private MortgageApplicationResponse? _application;
    private AffordabilityAssessmentResponse? _assessment;
    private string? _message;
    private List<string> _validationErrors = [];
    private bool _isError;
    private bool _isBusy;

    private async Task CreateApplicationAsync()
    {
        DismissValidationErrors();
        _isBusy = true;
        _message = null;
        _assessment = null;
        try
        {
            _application = await Api.CreateAsync(_request);
            if (_application is null)
            {
                SetMessage("The API did not return the new application. Please try again.", true);
                return;
            }
            _applicationId = _application.Id.ToString();
            SetMessage("Application submitted. Save the ID to retrieve it later.", false);
        }
        catch (InvalidOperationException exception)
        {
            SetMessage(exception.Message, true);
        }
        catch (HttpRequestException exception)
        {
            SetMessage(ServiceError(exception), true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RetrieveApplicationAsync()
    {
        if (!TryGetApplicationId(out Guid id)) return;
        _isBusy = true;
        _assessment = null;
        try
        {
            _application = await Api.GetAsync(id);
            SetMessage(_application is null ? "No application was returned." : "Application details loaded.", _application is null);
        }
        catch (HttpRequestException ex)
        {
            _application = null;
            SetMessage(ex.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "No application was found with that ID."
                : ServiceError(ex), true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task AssessApplicationAsync()
    {
        if (!TryGetApplicationId(out Guid id)) return;
        _isBusy = true;
        try
        {
            _assessment = await Api.AssessAsync(id);
            SetMessage(_assessment is null ? "No affordability result was returned." : "Affordability estimate loaded.", _assessment is null);
        }
        catch (HttpRequestException ex)
        {
            _assessment = null;
            SetMessage(ex.StatusCode switch
            {
                System.Net.HttpStatusCode.NotFound => "No application was found with that ID.",
                System.Net.HttpStatusCode.UnprocessableEntity => "The service could not calculate an estimate for these values.",
                _ => ServiceError(ex)
            }, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool TryGetApplicationId(out Guid id)
    {
        if (Guid.TryParse(_applicationId, out id))
        {
            _message = null;
            return true;
        }
        SetMessage("Enter a valid application ID.", true);
        return false;
    }

    private void ShowValidationErrors(EditContext editContext)
    {
        _validationErrors = editContext.GetValidationMessages()
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private void DismissValidationErrors() => _validationErrors.Clear();

    private async Task CopyApplicationIdAsync()
    {
        if (_application is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _application.Id.ToString());
            SetMessage("Application ID copied.", false);
        }
        catch (JSException)
        {
            SetMessage("Copy is not available here. Select the application ID and copy it manually.", true);
        }
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
    private static string ServiceError(HttpRequestException exception) => exception.StatusCode switch
    {
        System.Net.HttpStatusCode.Unauthorized => "The application service could not authenticate this request. Check the API key configuration.",
        System.Net.HttpStatusCode.Forbidden => "This client is not allowed to use the application service.",
        null => "Could not reach the application service. Check that the API is running, then try again.",
        _ => "The application service could not complete the request. Please try again later."
    };
    private static string Money(decimal amount) => amount.ToString("C0", CultureInfo.GetCultureInfo("en-GB"));
    private static string Percent(decimal value) => value.ToString("P1", CultureInfo.GetCultureInfo("en-GB"));
}
