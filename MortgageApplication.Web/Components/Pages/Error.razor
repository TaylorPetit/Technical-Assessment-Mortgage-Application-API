@page "/Error"

<PageTitle>Something went wrong</PageTitle>

<main class="page-shell">
    <section class="card">
        <p class="eyebrow">Request not completed</p>
        <h1>Something went wrong.</h1>
        <p class="lead">The page could not complete that request. Please return to the application and try again.</p>
        <a class="button button-primary" href="/">Return to the application</a>
    </section>
</main>
